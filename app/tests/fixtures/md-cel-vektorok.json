    ["<A%20B.md#^block>", "A B.md", "^block"],
    ["<A B.md>", "A B.md", null],
    ["A%2520B.md", "A%20B.md", null],
    ["A%23B%3FC.md", "A%23B%3FC.md", null],
    ["A%2FB.md", "A%2FB.md", null],
