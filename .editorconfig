# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{ts,js,mjs,json,svelte,css,html,yml,yaml,toml}]
indent_size = 2

[*.md]
# Trailing spaces can be meaningful (hard line breaks) in Markdown.
trim_trailing_whitespace = false

[*.swift]
indent_size = 4

[Makefile]
indent_style = tab
